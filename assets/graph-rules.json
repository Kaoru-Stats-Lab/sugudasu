{
  "schema_version": "1.1.0",
  "meta": {
    "role": "machine_readable_rule_definitions",
    "not": "research_report_dump",
    "human_docs": [
      "README.md",
      "DECISION_CONSTITUTION.md",
      "GRAPH_DETERMINISTIC_ENGINE.md",
      "GRAPH_RULES_ARCHITECT_REVIEW.md"
    ],
    "pipeline": [
      "observable_structure",
      "user_intent",
      "rule_match",
      "resolution_state",
      "graph_spec",
      "validation",
      "renderer"
    ],
    "out_of_scope": [
      "svg_rendering",
      "vega_lite_generation",
      "clipboard_implementation",
      "tsv_parser_implementation",
      "observable_extraction_algorithms"
    ],
    "rule_id_authority": "this_file",
    "updated": "2026-08-14",
    "schema_changelog": "1.1.0: NO_MATCH≠MISMATCH; deterministic_kind; CND-004 retarget; CONDITIONAL=human one question not AI. 1.1.1-notes: RLE-009A Nominal×target; CND-004 = target_as_line|marker|series (GRAPH_TARGET_REPRESENTATION)"
  },
  "engine": {
    "name": "SUGUDASU Graph Deterministic Rule Engine",
    "id": "sugudasu-graph",
    "mode": "deterministic",
    "llm_required": false,
    "llm_slot": false,
    "non_send": true,
    "default_output": "svg"
  },

  "principles": {
    "same_input_same_output": true,
    "observable_before_semantic": true,
    "user_intent_required": true,
    "no_hidden_inference": true,
    "observed_ne_recommended": true,
    "no_3d_charts": true,
    "zero_baseline_default": true,
    "unit_mismatch_prevents_stacking": true,
    "mismatch_is_success": true,
    "no_match_is_not_mismatch": true,
    "conditional_means_ask_human_one_question_not_ai": true
  },

  "deterministic_semantics": {
    "definition": "same_input_same_rule_version_same_output",
    "not_definition": "mathematically_unique_graph_from_structure_alone",
    "kinds": {
      "structure_unique": "Observable + Intent admit only one graph under Graph Constitution",
      "priority_fixed": "Multiple graphs could fit Observable; fixed rule priority / first_match_wins yields reproducible choice (not inference)"
    }
  },

  "capability_bound": {
    "status": "unresolved_pending_reaggregation",
    "note": "Research text mixed Decision State with Automation. CONVERTIBLE is not human confirmation. Do not treat 58/27/15 as state ratios.",
    "decision_states": [
      "MATCH",
      "CONVERTIBLE",
      "CONDITIONAL",
      "MISMATCH",
      "NO_MATCH"
    ],
    "automation_axis": {
      "status": "unresolved",
      "labels_proposed_not_final": [
        "auto_deterministic",
        "needs_confirmation"
      ],
      "legacy_research_claim_do_not_encode_as_fact": {
        "fully_deterministic_pct": null,
        "conditional_pct": null,
        "human_confirmation_pct": null,
        "original_ambiguous_labels": "MATCH 58% / CONDITIONAL 27% / User Confirmation or Convertible 15%",
        "hypothesis_only": ">=85% auto or one confirmation — not an implementation KPI until reaggregated"
      }
    }
  },

  "open_issues": [
    {
      "id": "U-01",
      "status": "unresolved",
      "summary": "Reaggregate 100-case corpus on Decision State vs Automation axes"
    },
    {
      "id": "U-02",
      "status": "unclear",
      "summary": "Catalog of CONVERTIBLE transforms that require confirmation vs auto-apply"
    },
    {
      "id": "U-03",
      "status": "unclear",
