{
  "manifest_version": 3,
  "name": "Mention by SUGUDASU",
  "version": "0.1.1",
  "description": "Find it. Done. — 今見ている言及を、定型展開で終わらせる。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mention by SUGUDASU",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://www.google.co.jp/maps/*",
    "https://maps.google.co.jp/*",
    "https://business.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://www.google.co.jp/maps/*",
        "https://maps.google.co.jp/*",
        "https://business.google.com/*"
      ],
      "js": ["content/adapters/google_maps.js", "content/extract.js"],
      "run_at": "document_idle"
    }
  ]
}
